flowchart TD
    INPUT["当前研究问题<br/>可附原始文档或语音转写"]

    subgraph STAGE1["阶段一　由研究问题生成纳排标准"]
        READ["1　完整阅读研究问题与相关原文"]
        FRAME["2　结合综述类型确定框架与要素维度"]
        EXTRACT["3　本地模型提取明确要素、限制、例外及关注内容"]
        RECORD["4　标准化表达，建立要素记录<br/>保留原文引文、范围与逻辑关系"]
        ROUTE{"候选要素明确且有引文？"}
        JEV["TypeSafe/Jev 按字段独立核对原文"]
        LOCAL["本地模型复核待定字段或候选要素"]
        FIDELITY{"独立复核结果"}
        REPAIR["仅修正受影响要素的措辞或数值<br/>再独立核对一次"]
        RECHECK{"修正后的复核结果"}
        STOP["停止本次生成，提示来源问题"]
        CHECK["5　检查歧义、缺失、冲突及需要新增假设之处"]
        MERGE["6　合并重复问题，输出提取结果与人工确认清单"]

        READ --> FRAME --> EXTRACT --> RECORD --> ROUTE
        ROUTE -->|是| JEV
        ROUTE -->|否| LOCAL
        JEV -->|全部字段达到阈值且来源支持| FIDELITY
        JEV -->|字段待定、结论存疑或服务不可用| LOCAL
        LOCAL --> FIDELITY
        FIDELITY -->|来源支持或原文确有歧义| CHECK
        FIDELITY -->|标准化表述偏离原文| REPAIR --> RECHECK
        RECHECK -->|来源支持或原文确有歧义| CHECK
        RECHECK -->|原文仍无法支持改写| STOP
        CHECK --> MERGE
    end

    INPUT -->|Generate| READ
    MERGE --> PENDING{"有影响纳排判断的待确认项？"}
    PENDING -->|无| OUTPUT["展示当前纳入标准、排除标准与描述"]
    PENDING -->|有| INLINE["展示已核实的标准<br/>在相应要素下列出待确认项与原文"]

    subgraph STAGE2["阶段二　作者确认后直接生效"]
        AUTHOR{"作者如何处理本项？"}
        ANSWER["选择选项或填写原答<br/>涉及多个不同要素时指定一项或全部"]
        APPLY["本地校验目标与版本并保存原答<br/>立即更新对应标准及描述，模型调用为零"]
        REMAIN{"还有其他待答项或未确认的目标？"}
        HOLD["保留该项待答"]
        AUTHOR -->|确认| ANSWER --> APPLY --> REMAIN
        AUTHOR -->|暂缓| HOLD
    end

    INLINE --> AUTHOR
    REMAIN -->|有| INLINE
    REMAIN -->|无| OUTPUT
    HOLD -->|稍后处理| INLINE

    CLEAR["用户点击 Criteria 的 Clear 并确认"]
    RESET["取消在途任务，清除标准、旧草稿、人工决定及附件<br/>保留问题框，阻止旧任务回写"]
    CLEAR --> RESET --> INPUT
